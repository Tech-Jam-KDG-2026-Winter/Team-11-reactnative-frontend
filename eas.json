{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {}
    },
    "production": {
      "autoIncrement": true,
      "env": {},
      "ios": {
        "resourceClass": "m1-medium"
      }
    }
  }
}
